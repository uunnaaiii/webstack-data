    {
      "id": "6ed2f2de-34fa-40bd-836c-0ad5aea7fecc",
      "name": "Build summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        320
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const settings = $('Settings').first().json;\nconst sites = $input.all().map(i => i.json);\nconst total = sites.reduce((n, s) => n + (s.brokenLinks || 0), 0);\nconst lines = sites.map(s => `- ${s.site}: ${s.brokenLinks || 0} broken of ${s.linksChecked || 0} links on ${s.pagesCrawled || 0} pages${s.error ? ' (error: ' + s.error + ')' : ''}`);\nreturn [{ json: {\n  total,\n  to: settings.alertEmail,\n  subject: `Broken links: ${total} found this week`,\n  body: `Weekly broken-link check\\n\\n${lines.join('\\n')}\\n\\nDetails: ${settings.sheetUrl}`\n} }];"
      }
    },
