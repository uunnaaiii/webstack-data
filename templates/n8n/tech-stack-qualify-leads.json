    {
      "id": "3ea743d8-4b35-4f19-84cd-214418ff3592",
      "name": "Batch of domains",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        860,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const max = $('Settings').first().json.maxDomainsPerRun || 200;\nconst domains = [...new Set($input.all().map(i => String(i.json.domain || '').trim()).filter(Boolean))].slice(0, max);\nif (!domains.length) return [];\nreturn [{ json: { domains } }];"
      }
    },
    {
      "id": "1b425029-132f-43c3-80a8-2ca19bfe8909",
      "name": "Detect tech stack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1060,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/uianalize~tech-stack-detector/run-sync-get-dataset-items",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "maxTotalChargeUsd",
              "value": "2"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ urls: $json.domains, includeFailed: true }) }}",
        "options": {
          "timeout": 300000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Apify API token"
        }
      }
    },
    {
      "id": "eedf5b64-1767-4399-b338-eb9367d7a844",
      "name": "Score fit",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1260,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const targets = $('Settings').first().json.targetTechnologies.map(t => t.toLowerCase());\nconst now = new Date().toISOString();\nreturn $input.all().map(({ json: r }) => {\n  const names = (r.technologies || []).map(t => t.name);\n  const matched = names.filter(n => targets.includes(n.toLowerCase()));\n  const cat = (c) => (r.categories?.[c] || []).join(', ');\n  return { json: {\n    domain: r.input,\n    cms: cat('CMS'),\n    ecommerce: cat('E-commerce'),\n    analytics: cat('Analytics'),\n    technologies: names.join(', ') || (r.error ? 'error: ' + r.error : ''),\n    matchedTech: matched.join(', '),\n    isFit: matched.length > 0 ? 'yes' : 'no',\n    techCheckedAt: now,\n  } };\n});"
      }
    },
    {
      "id": "90dd8dd6-d5d2-4ac4-8671-7623e6473086",
      "name": "Update lead row",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1500,
        100
      ],
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "sheetName": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {},
          "matchingColumns": [
            "domain"
          ],
          "schema": []
        },
        "options": {}
      }
    },
    {
      "id": "316d1a39-a288-47e2-9c67-a9450a35c4a4",
      "name": "Only fits",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        1500,
        320
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "be6b3d90-825c-4867-a38a-f45fe7a0dd68",
              "leftValue": "={{ $json.isFit }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "rightValue": "yes"
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "ddbbb0b8-5598-45a3-871a-a1f829706424",
      "name": "Build email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        320
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const rows = $input.all().map(i => i.json);\nif (!rows.length) return [];\nconst lines = rows.map(r => `- ${r.domain}: ${r.matchedTech}${r.cms ? ' (CMS: ' + r.cms + ')' : ''}`);\nreturn [{ json: {\n  to: $('Settings').first().json.alertEmail,\n  subject: `${rows.length} new lead(s) match your tech stack`,\n  body: `New leads that use your target technologies:\\n\\n${lines.join('\\n')}`,\n} }];"
      }
    },
    {
      "id": "0491227a-99cf-46b3-be5f-b836648b1089",
      "name": "Email new fits",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1860,
        320
      ],
      "parameters": {
        "sendTo": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "emailType": "text",
        "message": "={{ $json.body }}",
        "options": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "",
          "name": "Gmail account"
        }
      }
    }
