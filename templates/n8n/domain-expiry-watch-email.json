{
  "name": "Domain expiry watch (Webstack Data)",
  "nodes": [
    {
      "id": "9be882f8-8936-443a-82ab-7291097b5ebf",
      "name": "Read me",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -60,
        -60
      ],
      "parameters": {
        "width": 440,
        "height": 320,
        "content": "## Domain expiry watch\nEvery Monday this workflow checks your domains with the **Domain Availability Checker** Actor on Apify (official RDAP/WHOIS registry data) and emails you the ones that expire within 45 days, or that are no longer registered.\n\n**Setup (5 min)**\n1. Create an *HTTP Header Auth* credential: name `Authorization`, value `Bearer YOUR_APIFY_TOKEN`.\n2. Put your domains in the JSON body of *Check domains*.\n3. Connect Gmail and set your address in *Email me*.\n\n**Cost:** $0.0015 per domain checked. 20 domains every week is about $0.13 per month."
      }
    },
    {
      "id": "69cefc31-653e-45bb-85de-1634f5e614a0",
      "name": "Every Monday",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "weeksInterval": 1,
              "triggerAtDay": [
                1
              ],
              "triggerAtHour": 8
            }
          ]
        }
      }
    },
    {
      "id": "85901a5f-46da-41d7-9864-3c329d585fe5",
      "name": "Check domains",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/uianalize~domain-availability-checker/run-sync-get-dataset-items",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "maxTotalChargeUsd",
              "value": "1"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"domains\": [\"example.com\", \"example.org\"]\n}",
        "options": {
          "timeout": 300000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Apify API token"
        }
      }
    },
    {
      "id": "a5b415ed-a8d2-45df-913a-5febf5ebd752",
      "name": "Expiring or lost",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        480,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "a1",
              "leftValue": "={{ $json.daysUntilExpiry ?? 9999 }}",
              "rightValue": 45,
              "operator": {
                "type": "number",
                "operation": "lt"
              }
            },
            {
              "id": "a2",
              "leftValue": "={{ $json.status }}",
              "rightValue": "available",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      }
    },
    {
      "id": "c1",
      "name": "Build email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const lines = $input.all().map(i => i.json.status === 'available'\n  ? `${i.json.domain}: NOT REGISTERED any more (status available)`\n  : `${i.json.domain}: expires ${i.json.expiresAt} (${i.json.daysUntilExpiry} days), registrar ${i.json.registrar || 'unknown'}`);\nreturn [{ json: { subject: `${lines.length} domain(s) need attention`, body: lines.join('\\n') } }];"
      }
    },
    {
      "id": "m1",
      "name": "Email me",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        960,
        300
      ],
      "parameters": {
        "sendTo": "you@example.com",
        "subject": "={{ $json.subject }}",
        "emailType": "text",
        "message": "={{ $json.body }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Every Monday": {
      "main": [
        [
          {
            "node": "Check domains",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check domains": {
      "main": [
        [
          {
            "node": "Expiring or lost",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Expiring or lost": {
      "main": [
        [
          {
            "node": "Build email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build email": {
      "main": [
        [
          {
            "node": "Email me",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": false
  }
}